# ---------------------------------------------------------------------------
# DO101 environment
#
# Every variable here is optional except NEXT_PUBLIC_SITE_URL. The whole site —
# all 28 tools, all four games — works with an empty .env.local.
# Copy this file to .env.local for development.
# ---------------------------------------------------------------------------

# Canonical origin. Used for canonical URLs, Open Graph tags, the sitemap and
# the Typing Battle invite links. No trailing slash.
# Development: http://localhost:3000   Production: https://do101.online
NEXT_PUBLIC_SITE_URL=https://do101.online

# Shown on /contact. Leave blank and the page says the address is not
# configured rather than inventing a support inbox.
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional. Used for Twitter card attribution, e.g. @do101online
NEXT_PUBLIC_TWITTER_HANDLE=

# ---------------------------------------------------------------------------
# DO101 AI (optional)
#
# SECRET — server side only. Never prefix an API key with NEXT_PUBLIC_.
# With no key set, /ai falls back to its built-in rule-based router and every
# tool keeps working exactly as before.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# Defaults to claude-haiku-4-5-20251001, which is cheap and fast enough for routing.
ANTHROPIC_MODEL=

# ---------------------------------------------------------------------------
# Google AdSense (optional)
#
# No ad script is loaded and no ad slot renders unless the publisher id is set,
# so development and un-approved deployments stay completely ad-free.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_HOME=
NEXT_PUBLIC_ADSENSE_SLOT_TOOL=
NEXT_PUBLIC_ADSENSE_SLOT_DIRECTORY=
NEXT_PUBLIC_ADSENSE_SLOT_GAMES=
